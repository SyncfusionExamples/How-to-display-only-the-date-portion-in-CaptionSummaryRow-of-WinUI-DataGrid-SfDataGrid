<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SfDataGridDemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SfDataGridDemo"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dataGrid="using:Syncfusion.UI.Xaml.DataGrid"
    xmlns:grids="using:Syncfusion.UI.Xaml.Grids"
    xmlns:core="using:Syncfusion.UI.Xaml.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SfDataGridDemo">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="rootGrid">
        <Grid.DataContext>
            <local:ViewModel/>
        </Grid.DataContext>
        <dataGrid:SfDataGrid x:Name="SortsDataGrid"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            AllowDraggingColumns="False"
                            AllowEditing="False"
                            AllowFiltering="True"
                            AllowGrouping="True"
                            AllowSorting="True"
                            AutoGenerateColumns="False"
                            ColumnWidthMode="Auto"
                            ItemsSource="{Binding Source, Mode=TwoWay}"
                            SelectionMode="Single"
                            ShowGroupDropArea="True">
            <dataGrid:SfDataGrid.Columns>
                <dataGrid:GridNumericColumn
                            HeaderText="Day"
                            MappingName="Value" />

                <dataGrid:GridNumericColumn
                            HeaderText="Month"
                            MappingName="Value2" />

                <dataGrid:GridDateColumn
                             DisplayDateFormat="MM/dd/yyyy"
                             HeaderText="Date"
                             MappingName="Date1" /> 
            </dataGrid:SfDataGrid.Columns>
        </dataGrid:SfDataGrid>
    </Grid>
</Window>